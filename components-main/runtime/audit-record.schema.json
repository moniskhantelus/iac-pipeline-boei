{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provisional S010 mapping v1; owner approval required",
  "type": "object",
  "required": [
    "actor",
    "commit_sha",
    "plan_hash",
    "timestamp",
    "environment",
    "module",
    "outcome",
    "pipeline_id",
    "job_id",
    "project_path",
    "mr_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "plan_hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "sandbox",
        "dev",
        "uat",
        "prod"
      ]
    },
    "module": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "success",
        "failure",
        "unknown"
      ]
    },
    "pipeline_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "project_path": {
      "type": "string",
      "minLength": 1
    },
    "mr_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
